# Environment and secrets
.env
.env.*
!.env.example

# Dependencies and front-end tooling
/node_modules
/public/hot
npm-debug.log
yarn-error.log

# Runtime files
/public/storage
/storage/*.key
/storage/pail
/storage/logs/*.log
/storage/framework/cache/data/*
